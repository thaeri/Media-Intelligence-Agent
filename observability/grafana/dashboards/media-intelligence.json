        { "refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(media_agent_request_duration_seconds_bucket[5m])))", "legendFormat": "p95", "exemplar": true },
        { "refId": "C", "expr": "histogram_quantile(0.99, sum by (le) (rate(media_agent_request_duration_seconds_bucket[5m])))", "legendFormat": "p99", "exemplar": true }
