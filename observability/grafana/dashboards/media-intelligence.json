  "panels": [
    {
      "id": 1, "type": "timeseries", "title": "API request rate",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum(rate(http_server_request_duration_seconds_count{service_name=\"media-intelligence-api\"}[5m]))", "legendFormat": "requests/s", "exemplar": true }],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 }
    },
    {
      "id": 2, "type": "timeseries", "title": "API latency p50 / p95 / p99",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.50, sum by (le) (rate(http_server_request_duration_seconds_bucket{service_name=\"media-intelligence-api\"}[5m])))", "legendFormat": "p50", "exemplar": true },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{service_name=\"media-intelligence-api\"}[5m])))", "legendFormat": "p95", "exemplar": true },
        { "refId": "C", "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_request_duration_seconds_bucket{service_name=\"media-intelligence-api\"}[5m])))", "legendFormat": "p99", "exemplar": true }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 16, "x": 8, "y": 0 }
    },
    {
